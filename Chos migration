-- =========================================================
-- سبد من | Version 6 | Notes / دفترچه یادداشت
-- =========================================================

create table if not exists public.notes (
    id uuid primary key default gen_random_uuid(),

    title text not null default 'یادداشت',

    content text not null default '',

    created_at timestamptz not null default now(),

    updated_at timestamptz not null default now()
);

-- =========================================================
-- فعال‌سازی RLS
-- =========================================================

alter table public.notes enable row level security;

-- =========================================================
-- حذف Policy های قبلی در صورت وجود
-- =========================================================

drop policy if exists "authenticated users can read notes"
on public.notes;

drop policy if exists "authenticated users can insert notes"
on public.notes;

drop policy if exists "authenticated users can update notes"
on public.notes;

drop policy if exists "authenticated users can delete notes"
on public.notes;

-- =========================================================
-- دسترسی کاربران واردشده
-- =========================================================

create policy "authenticated users can read notes"
on public.notes
for select
to authenticated
using (true);

create policy "authenticated users can insert notes"
on public.notes
for insert
to authenticated
with check (true);

create policy "authenticated users can update notes"
on public.notes
for update
to authenticated
using (true)
with check (true);

create policy "authenticated users can delete notes"
on public.notes
for delete
to authenticated
using (true);

-- =========================================================
-- تابع بروزرسانی خودکار updated_at
-- =========================================================

create or replace function public.update_notes_updated_at()
returns trigger
language plpgsql
as $$
begin
    new.updated_at = now();
    return new;
end;
$$;

-- =========================================================
-- Trigger
-- =========================================================

drop trigger if exists notes_updated_at
on public.notes;

create trigger notes_updated_at
before update on public.notes
for each row
execute function public.update_notes_updated_at();

